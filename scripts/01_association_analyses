  PCGrimAge = "EAA_PCGrimAge",
  DNAmFitAge = "EAA_DNAmFitAge",
  OMICmAge = "EAA_OMICmAge",
  Retroclock = "EAA_Retroclock",
  `Retroclock 2` = "EAA_Retroclock2",
  AdaptAge = "EAA_AdaptAge",
  DamAge = "EAA_DamAge",
  IntrinsicCapacity = "IntrinsicCapacity",
  DunedinPACE = "DunedinPACE",
  Brain = "EAA_Brain",
  Metabolic = "EAA_Metabolic",
  Hormone = "EAA_Hormone",
  Liver = "EAA_Liver",
  Inflammation = "EAA_Inflammation",
  SystemsAge = "EAA_SystemsAge",
  Blood = "EAA_Blood",
  MusculoSkeletal = "EAA_MusculoSkeletal",
  Kidney = "EAA_Kidney",
  Heart = "EAA_Heart",
  Immune = "EAA_Immune",
  Lung = "EAA_Lung"
)

non_organ_clocks <- c(
  Horvath = "EAA_Horvath",
  Hannum = "EAA_Hannum",
  IntrinClock = "EAA_IntrinClock",
  cAge = "EAA_cAge",
  PhenoAge = "EAA_PhenoAge",
  PCGrimAge = "EAA_PCGrimAge",
  DNAmFitAge = "EAA_DNAmFitAge",
  OMICmAge = "EAA_OMICmAge",
  Retroclock = "EAA_Retroclock",
  `Retroclock 2` = "EAA_Retroclock2",
  AdaptAge = "EAA_AdaptAge",
  DamAge = "EAA_DamAge",
  IntrinsicCapacity = "IntrinsicCapacity",
  DunedinPACE = "DunedinPACE"
)

organ_system_clocks <- c(
  Brain = "EAA_Brain",
  Metabolic = "EAA_Metabolic",
  Hormone = "EAA_Hormone",
  Liver = "EAA_Liver",
  Inflammation = "EAA_Inflammation",
  SystemsAge = "EAA_SystemsAge",
  Blood = "EAA_Blood",
  MusculoSkeletal = "EAA_MusculoSkeletal",
  Kidney = "EAA_Kidney",
  Heart = "EAA_Heart",
  Immune = "EAA_Immune",
  Lung = "EAA_Lung"
)

clock_table <- bind_rows(
  tibble(
    Family = "Non-organ",
    Clock = names(non_organ_clocks),
    Variable = unname(non_organ_clocks)
  ),
  tibble(
    Family = "Organ / Systems",
    Clock = names(organ_system_clocks),
    Variable = unname(organ_system_clocks)
  )
)

eaa_family_lookup <- setNames(
  clock_table$Family,
  clock_table$Clock
)


# Data preparation --------------------------------------------------------

required_vars <- unique(c(
  var_age,
  var_sex,
  var_smoking,
  var_country,
  var_binary_diagnosis,
  var_clinical,
  unname(social_vars),
  unname(brain_age_vars),
  unname(eaa_vars)
))

missing_vars <- setdiff(required_vars, names(data_base))

if (length(missing_vars) > 0) {
  stop(
    paste(
      "Required variables are missing:",
      paste(missing_vars, collapse = ", ")
    )
  )
}

numeric_vars <- unique(c(
  var_age,
  unname(social_vars),
  unname(brain_age_vars),
  unname(eaa_vars)
))

data_base <- data_base %>%
  mutate(
    across(
      all_of(numeric_vars),
      ~ suppressWarnings(as.numeric(.x))
    ),
    across(
      all_of(c(
        var_sex,
        var_smoking,
        var_country,
        var_binary_diagnosis,
        var_clinical
      )),
      as.factor
    )
  )


# Samples -----------------------------------------------------------------

sample_order <- c(
  "Full sample",
  "Dementia",
  "AD",
  "FTD",
  "HC"
)

get_sample <- function(data, sample_name) {

  if (sample_name == "Full sample") {
    return(data)
  }

  if (sample_name == "Dementia") {
    return(
      data %>%
        filter(
          .data[[var_clinical]] %in% c("AD", "FTD")
        )
    )
  }

  data %>%
    filter(
      .data[[var_clinical]] == sample_name
    )
}

order_by_sample <- function(data) {
  data %>%
    mutate(
      .sample_order = match(Sample, sample_order)
    ) %>%
    arrange(.sample_order) %>%
    select(-.sample_order)
}


# Model functions ---------------------------------------------------------

get_varying_covariates <- function(data, covariates) {

  keep <- vapply(
    covariates,
    function(v) {

      x <- data[[v]]
      x <- x[!is.na(x)]

      if (length(x) == 0) {
        return(FALSE)
      }

      if (is.numeric(x)) {
        sx <- sd(x)
        return(is.finite(sx) && sx > 0)
      }

      length(unique(x)) > 1
    },
    logical(1)
  )

  covariates[keep]
}

run_linear_model <- function(
  data,
  sample_label,
  exposure_label,
  exposure_variable,
  outcome_label,
  outcome_variable,
  family_label,
  covariates,
  min_n = 20
) {

  covariates_use <- get_varying_covariates(
    data,
    covariates
  )

  model_vars <- unique(c(
    outcome_variable,
    exposure_variable,
    covariates_use
  ))

  model_data <- data %>%
    select(all_of(model_vars)) %>%
    drop_na() %>%
    as.data.frame() %>%
    droplevels()

  n_model <- nrow(model_data)

  empty_result <- function(status) {
    tibble(
      Sample = sample_label,
      Exposure = exposure_label,
      Outcome = outcome_label,
      Family = family_label,
      N = n_model,
      Beta = NA_real_,
      SE = NA_real_,
      Beta_std = NA_real_,
      CI_low_std = NA_real_,
      CI_high_std = NA_real_,
      p_value = NA_real_,
      R2_full = NA_real_,
      R2_reduced = NA_real_,
      Adjusted_R2 = NA_real_,
      Delta_R2 = NA_real_,
      f2 = NA_real_,
      Status = status
    )
  }

  if (n_model < min_n) {
    return(empty_result("Insufficient N"))
  }

  sd_x <- sd(
    model_data[[exposure_variable]],
    na.rm = TRUE
  )

  sd_y <- sd(
    model_data[[outcome_variable]],
    na.rm = TRUE
  )

  if (
    !is.finite(sd_x) ||
    !is.finite(sd_y) ||
    sd_x == 0 ||
    sd_y == 0
  ) {
    return(empty_result("No variability"))
  }

  full_formula <- reformulate(
    c(
      exposure_variable,
      covariates_use
    ),
    response = outcome_variable
  )

  reduced_formula <- reformulate(
    covariates_use,
    response = outcome_variable
  )

  full_fit <- tryCatch(
    lm(
      full_formula,
      data = model_data
    ),
    error = function(e) NULL
  )

  reduced_fit <- tryCatch(
    lm(
      reduced_formula,
      data = model_data
    ),
    error = function(e) NULL
  )

  if (
    is.null(full_fit) ||
    is.null(reduced_fit)
  ) {
    return(empty_result("Model error"))
  }

  term_result <- broom::tidy(
    full_fit,
    conf.int = TRUE,
    conf.level = 0.95
  ) %>%
    filter(
      term == exposure_variable
    )

  if (nrow(term_result) != 1) {
    return(empty_result("Coefficient unavailable"))
  }

  standardization_factor <- sd_x / sd_y

  r2_full <- summary(full_fit)$r.squared
  r2_reduced <- summary(reduced_fit)$r.squared
  delta_r2 <- r2_full - r2_reduced

  tibble(
    Sample = sample_label,
    Exposure = exposure_label,
    Outcome = outcome_label,
    Family = family_label,
    N = nobs(full_fit),
    Beta = term_result$estimate,
    SE = term_result$std.error,
    Beta_std = term_result$estimate * standardization_factor,
    CI_low_std = term_result$conf.low * standardization_factor,
    CI_high_std = term_result$conf.high * standardization_factor,
    p_value = term_result$p.value,
    R2_full = r2_full,
    R2_reduced = r2_reduced,
    Adjusted_R2 = summary(full_fit)$adj.r.squared,
    Delta_R2 = delta_r2,
    f2 = ifelse(
      is.finite(r2_full) && r2_full < 1,
      delta_r2 / (1 - r2_full),
      NA_real_
    ),
    Status = "OK"
  )
}


# 1. Social exposome and epigenetic aging --------------------------------

eaa_covariates <- c(
  var_age,
  var_sex,
  var_smoking,
  var_country,
  var_binary_diagnosis
)

eaa_grid <- crossing(
  Sample = sample_order,
  Exposure = names(social_vars),
  Clock = names(eaa_vars)
) %>%
  mutate(
    Family = unname(
      eaa_family_lookup[Clock]
    )
  )

eaa_results <- pmap_dfr(
  eaa_grid,
  function(
    Sample,
    Exposure,
    Clock,
    Family
  ) {

    run_linear_model(
      data = get_sample(
        data_base,
        Sample
      ),
      sample_label = Sample,
      exposure_label = Exposure,
      exposure_variable = social_vars[[Exposure]],
      outcome_label = Clock,
      outcome_variable = eaa_vars[[Clock]],
      family_label = Family,
      covariates = eaa_covariates,
      min_n = 20
    )
  }
) %>%
  group_by(
    Sample,
    Exposure,
    Family
  ) %>%
  mutate(
    FDR = p.adjust(
      p_value,
      method = "BH"
    )
  ) %>%
  ungroup() %>%
  mutate(
    Significant_nominal =
      !is.na(p_value) &
      p_value < 0.05,
    Significant_FDR =
      !is.na(FDR) &
      FDR < 0.05
  ) %>%
  order_by_sample()


# 2. Social exposome and brain aging -------------------------------------

brain_covariates <- c(
  var_age,
  var_sex,
  var_smoking
)

brain_grid <- crossing(
  Sample = sample_order,
  Exposure = names(social_vars),
  Brain_age = names(brain_age_vars)
)

brain_results <- pmap_dfr(
  brain_grid,
  function(
    Sample,
    Exposure,
    Brain_age
  ) {

    run_linear_model(
      data = get_sample(
        data_base,
        Sample
      ),
      sample_label = Sample,
      exposure_label = Exposure,
      exposure_variable = social_vars[[Exposure]],
      outcome_label = Brain_age,
      outcome_variable = brain_age_vars[[Brain_age]],
      family_label = "Brain age",
      covariates = brain_covariates,
      min_n = 20
    )
  }
) %>%
  group_by(
    Sample,
    Exposure
  ) %>%
  mutate(
    FDR = p.adjust(
      p_value,
      method = "BH"
    )
  ) %>%
  ungroup() %>%
  mutate(
    Significant_nominal =
      !is.na(p_value) &
      p_value < 0.05,
    Significant_FDR =
      !is.na(FDR) &
      FDR < 0.05
  ) %>%
  order_by_sample()


# 3. Epigenetic and brain aging convergence ------------------------------

convergence_grid <- crossing(
  Brain_age = names(brain_age_vars),
  Family = unique(clock_table$Family)
) %>%
  left_join(
    clock_table,
    by = "Family"
  )

convergence_results <- pmap_dfr(
  convergence_grid,
  function(
    Brain_age,
    Family,
    Clock,
    Variable
  ) {

    run_linear_model(
      data = data_base,
      sample_label = "Full sample",
      exposure_label = Clock,
      exposure_variable = Variable,
      outcome_label = Brain_age,
      outcome_variable = brain_age_vars[[Brain_age]],
      family_label = Family,
      covariates = brain_covariates,
      min_n = 30
    )
  }
) %>%
  group_by(
    Outcome,
    Family
  ) %>%
  mutate(
    FDR = p.adjust(
      p_value,
      method = "BH"
    )
  ) %>%
  ungroup() %>%
  mutate(
    Significant_nominal =
      !is.na(p_value) &
      p_value < 0.05,
    Significant_FDR =
      !is.na(FDR) &
      FDR < 0.05,
    Direction = case_when(
      Beta_std > 0 ~ "Positive",
      Beta_std < 0 ~ "Negative",
      TRUE ~ "Null"
    )
  )
