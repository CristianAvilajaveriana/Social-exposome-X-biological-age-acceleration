# ============================================================
# Social Exposome and Biological Aging Association Analyses
#
# Analyses included:
# 1) Social exposome associations with epigenetic aging measures
# 2) Social exposome associations with functional and structural brain aging
# 3) Convergence between epigenetic aging measures and brain aging
#
# Models report standardized beta coefficients, 95% confidence intervals,
# adjusted R-squared, Cohen's f-squared, and Benjamini-Hochberg FDR-adjusted p-values.
# ============================================================


# Packages ----------------------------------------------------------------

packages <- c(
  "readxl",
  "dplyr",
  "tidyr",
  "purrr",
  "tibble",
  "broom",
  "openxlsx"
)

missing_packages <- packages[
  !vapply(packages, requireNamespace, logical(1), quietly = TRUE)
]

if (length(missing_packages) > 0) {
  install.packages(missing_packages, dependencies = TRUE)
}

library(readxl)
library(dplyr)
library(tidyr)
library(purrr)
library(tibble)
library(broom)
library(openxlsx)


# Paths -------------------------------------------------------------------

project_dir <- "."
input_file <- file.path(project_dir, "data", "analysis_data.xlsx")


# Data --------------------------------------------------------------------

data_base <- read_excel(input_file)


# Variables ---------------------------------------------------------------

var_age <- "age"
var_sex <- "sex"
var_smoking <- "smoking"
var_country <- "country"
var_binary_diagnosis <- "diagnosis_binary"
var_clinical <- "clinical_diagnosis"

social_vars <- c(
  CSRI = "CSRI",
  MSE = "MSE",
  Education = "Education",
  `Social support` = "Social_support",
  SES = "SES",
  Adversities = "Adversities"
)

