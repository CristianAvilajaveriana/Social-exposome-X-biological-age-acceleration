# ============================================================
# Targeted Mediation Analyses
# Social Exposome -> Biological Aging -> Clinical Outcomes
#
# Mediation models are restricted to biological aging measures
# that were FDR-significantly associated with the corresponding
# social exposure in the preceding association analyses.
#
# Analyses included:
# 1) Social exposome -> epigenetic aging -> clinical outcomes
# 2) Social exposome -> functional/structural brain aging -> clinical outcomes
#
# Clinical outcomes:
# MMSE, T-ADLQ, executive function, emotion recognition, and CDR.
# CDR is evaluated only in Dementia, AD, and FTD.
# ============================================================


# Packages ----------------------------------------------------------------

library(dplyr)
library(tidyr)
library(purrr)
library(tibble)
library(mediation)


# Inputs ------------------------------------------------------------------
#
# data_base, eaa_results, and brain_results are obtained from the
# preceding association analyses.


# Settings ----------------------------------------------------------------

n_boot <- 5000
seed_base <- 20260824


# Variables ---------------------------------------------------------------

var_age <- "age"
var_sex <- "sex"
var_smoking <- "smoking"
var_country <- "country"
var_binary_diagnosis <- "diagnosis_binary"
var_clinical <- "clinical_diagnosis"

social_vars <- c(
  CSRI = "CSRI",
  MSE = "MSE",
  Education = "Education",
  `Social support` = "Social_support",
  SES = "SES",
  Adversities = "Adversities"
)

primary_exposures <- c(
  "CSRI",
  "MSE"
)

secondary_exposures <- c(
  "Education",
  "Social support",
  "SES",
  "Adversities"
)

eaa_vars <- c(
  Horvath = "EAA_Horvath",
  Hannum = "EAA_Hannum",
  IntrinClock = "EAA_IntrinClock",
  cAge = "EAA_cAge",
  PhenoAge = "EAA_PhenoAge",
  PCGrimAge = "EAA_PCGrimAge",
  DNAmFitAge = "EAA_DNAmFitAge",
  OMICmAge = "EAA_OMICmAge",
  Retroclock = "EAA_Retroclock",
  `Retroclock 2` = "EAA_Retroclock2",
  AdaptAge = "EAA_AdaptAge",
  DamAge = "EAA_DamAge",
  DunedinPACE = "DunedinPACE",
  Brain = "EAA_Brain",
  Metabolic = "EAA_Metabolic",
  Hormone = "EAA_Hormone",
  Liver = "EAA_Liver",
  Inflammation = "EAA_Inflammation",
  SystemsAge = "EAA_SystemsAge",
  Blood = "EAA_Blood",
  MusculoSkeletal = "EAA_MusculoSkeletal",
  Kidney = "EAA_Kidney",
  Heart = "EAA_Heart",
  Immune = "EAA_Immune",
  Lung = "EAA_Lung"
)

brain_age_vars <- c(
  `Functional brain age` = "functional_brain_age_gap",
  `Structural brain age` = "structural_brain_age_gap"
)

clinical_outcomes <- c(
  MMSE = "MMSE",
  `T-ADLQ total` = "T_ADLQ",
  `Executive function` = "Executive_Function",
  `Emotion recognition` = "Emotion_Recognition",
  CDR = "CDR"
)


# Targeted mediator selection ---------------------------------------------
#
# Candidate mediators are selected from the preceding association analyses.
# A biological aging measure enters mediation only when the corresponding
# Social exposure -> aging association reached FDR < 0.05 in that sample.
#
# IntrinsicCapacity is not included as an epigenetic mediator.

selected_eaa <- eaa_results %>%
  filter(
    Significant_FDR,
    Outcome != "IntrinsicCapacity"
  ) %>%
  transmute(
    Sample,
    Exposure,
    Family,
    Mediator = Outcome,
    Mediator_variable = unname(
      eaa_vars[Outcome]
    ),
    Mediator_type = "Epigenetic",
    Selection_FDR = FDR
  ) %>%
  distinct()

selected_brain <- brain_results %>%
  filter(
    Significant_FDR
  ) %>%
  transmute(
    Sample,
    Exposure,
    Family = Outcome,
    Mediator = Outcome,
    Mediator_variable = unname(
      brain_age_vars[Outcome]
    ),
    Mediator_type = "Brain aging",
    Selection_FDR = FDR
  ) %>%
  distinct()

selected_mediators <- bind_rows(
  selected_eaa,
  selected_brain
) %>%
  mutate(
    Tier = case_when(
      Exposure %in% primary_exposures ~ "Primary",
      Exposure %in% secondary_exposures ~ "Secondary domain-level",
      TRUE ~ NA_character_
    )
  ) %>%
  filter(
    !is.na(Tier),
    !is.na(Mediator_variable)
  )


# Samples -----------------------------------------------------------------

sample_order <- c(
  "Full sample",
  "Dementia",
  "AD",
  "FTD",
  "HC"
)

get_sample <- function(
  data,
  sample_name
) {

  if (sample_name == "Full sample") {
    return(data)
  }

  if (sample_name == "Dementia") {
    return(
      data %>%
        filter(
          .data[[var_clinical]] %in% c(
            "AD",
            "FTD"
          )
        )
    )
  }

  data %>%
    filter(
      .data[[var_clinical]] == sample_name
    )
}


# Clinical outcome rules --------------------------------------------------

get_outcomes <- function(
  sample_name
) {

  outcomes <- c(
    "MMSE",
    "T-ADLQ total",
    "Executive function",
    "Emotion recognition"
  )

  if (
    sample_name %in% c(
      "Dementia",
      "AD",
      "FTD"
    )
  ) {
    outcomes <- c(
      outcomes,
      "CDR"
    )
  }

  outcomes
}


# Covariates --------------------------------------------------------------

get_covariates <- function(
  mediator_type,
  sample_name
) {

  if (mediator_type == "Epigenetic") {

    if (sample_name == "Full sample") {
      return(
        c(
          var_age,
          var_sex,
          var_smoking,
          var_country,
          var_binary_diagnosis
        )
      )
    }

    return(
      c(
        var_age,
        var_sex,
        var_smoking,
        var_country
      )
    )
  }

  c(
    var_age,
    var_sex,
    var_smoking
  )
}


# Model grid --------------------------------------------------------------

mediation_grid <- map_dfr(
  seq_len(
    nrow(selected_mediators)
  ),
  function(i) {

    current <- selected_mediators[
      i,
      ,
      drop = FALSE
    ]

    tibble(
      Tier = current$Tier,
      Sample = current$Sample,
      Exposure = current$Exposure,
      Mediator_type = current$Mediator_type,
      Family = current$Family,
      Mediator = current$Mediator,
      Mediator_variable = current$Mediator_variable,
      Selection_FDR = current$Selection_FDR,
      Outcome = get_outcomes(
        current$Sample
      )
    )
  }
) %>%
  mutate(
    Model_number = row_number(),
    Model_seed = seed_base + Model_number
  )


# Mediation model ---------------------------------------------------------

run_mediation_model <- function(
  current
) {

  sample_name <- current$Sample[[1]]
  exposure_label <- current$Exposure[[1]]
  exposure_var <- social_vars[[exposure_label]]

  mediator_type <- current$Mediator_type[[1]]
  mediator_label <- current$Mediator[[1]]
  mediator_var <- current$Mediator_variable[[1]]

  outcome_label <- current$Outcome[[1]]
  outcome_var <- clinical_outcomes[[outcome_label]]

  covariates <- get_covariates(
    mediator_type,
    sample_name
  )

  model_data <- get_sample(
    data_base,
    sample_name
  ) %>%
    select(
      all_of(
        unique(
          c(
            exposure_var,
            mediator_var,
            outcome_var,
            covariates
          )
        )
      )
    ) %>%
    drop_na() %>%
    as.data.frame() %>%
    droplevels()

  varying_covariates <- vapply(
    covariates,
    function(v) {

      x <- model_data[[v]]

      if (is.numeric(x)) {
        sx <- sd(
          x,
          na.rm = TRUE
        )

        return(
          is.finite(sx) &&
            sx > 0
        )
      }

      length(
        unique(
          na.omit(x)
        )
      ) > 1
    },
    logical(1)
  )

  covariates_use <- covariates[
    varying_covariates
  ]

  n_model <- nrow(model_data)

  empty_result <- function(
    status
  ) {

    tibble(
      Model_number = current$Model_number[[1]],
      Tier = current$Tier[[1]],
      Sample = sample_name,
      Exposure = exposure_label,
      Mediator_type = mediator_type,
      Family = current$Family[[1]],
      Mediator = mediator_label,
      Selection_FDR = current$Selection_FDR[[1]],
      Outcome = outcome_label,
      N = n_model,
      Path_a_beta = NA_real_,
      Path_a_beta_std = NA_real_,
      Path_a_p = NA_real_,
      Path_b_beta = NA_real_,
      Path_b_beta_std = NA_real_,
      Path_b_p = NA_real_,
      Total_effect_c = NA_real_,
      Total_effect_c_std = NA_real_,
      Total_effect_c_p = NA_real_,
      Direct_effect_cprime = NA_real_,
      Direct_effect_cprime_std = NA_real_,
      Direct_effect_cprime_p = NA_real_,
      Indirect_ab = NA_real_,
      Indirect_ab_std = NA_real_,
      ACME = NA_real_,
      ACME_CI_low = NA_real_,
      ACME_CI_high = NA_real_,
      ACME_p = NA_real_,

      ACME_std = NA_real_,
      ACME_std_CI_low = NA_real_,
      ACME_std_CI_high = NA_real_,
      ADE = NA_real_,
      ADE_CI_low = NA_real_,
      ADE_CI_high = NA_real_,
      ADE_p = NA_real_,
      Total_effect = NA_real_,
      Total_effect_CI_low = NA_real_,
      Total_effect_CI_high = NA_real_,
      Total_effect_p = NA_real_,
      Prop_mediated = NA_real_,
      Prop_mediated_CI_low = NA_real_,
      Prop_mediated_CI_high = NA_real_,
      Prop_mediated_p = NA_real_,
      Status = status
    )
  }

  if (n_model < 30) {
    return(
      empty_result(
        "Insufficient N"
      )
    )
  }

  sd_x <- sd(
    model_data[[exposure_var]]
  )

  sd_m <- sd(
    model_data[[mediator_var]]
  )

  sd_y <- sd(
    model_data[[outcome_var]]
  )

  if (
    !is.finite(sd_x) ||
    !is.finite(sd_m) ||
    !is.finite(sd_y) ||
    sd_x == 0 ||
    sd_m == 0 ||
    sd_y == 0
  ) {
    return(
      empty_result(
        "Zero variance"
      )
    )
  }

  mediator_formula <- reformulate(
    c(
      exposure_var,
      covariates_use
    ),
    response = mediator_var
  )

  outcome_formula <- reformulate(
    c(
      exposure_var,
      mediator_var,
      covariates_use
    ),
    response = outcome_var
  )

  total_formula <- reformulate(
    c(
      exposure_var,
      covariates_use
    ),
    response = outcome_var
  )

  model_m <- lm(
    mediator_formula,
    data = model_data
  )

  model_y <- lm(
    outcome_formula,
    data = model_data
  )

  model_total <- lm(
    total_formula,
    data = model_data
  )

  coef_m <- summary(
    model_m
  )$coefficients

  coef_y <- summary(
    model_y
  )$coefficients

  coef_total <- summary(
    model_total
  )$coefficients

  path_a_beta <- unname(
    coef_m[
      exposure_var,
      "Estimate"
    ]
  )

  path_a_p <- unname(
    coef_m[
      exposure_var,
      ncol(coef_m)
    ]
  )

  path_b_beta <- unname(
    coef_y[
      mediator_var,
      "Estimate"
    ]
  )

  path_b_p <- unname(
    coef_y[
      mediator_var,
      ncol(coef_y)
    ]
  )

  direct_beta <- unname(
    coef_y[
      exposure_var,
      "Estimate"
    ]
  )

  direct_p <- unname(
    coef_y[
      exposure_var,
      ncol(coef_y)
    ]
  )

  total_c_beta <- unname(
    coef_total[
      exposure_var,
      "Estimate"
    ]
  )

  total_c_p <- unname(
    coef_total[
      exposure_var,
      ncol(coef_total)
    ]
  )

  path_a_beta_std <-
    path_a_beta *
    sd_x /
    sd_m

  path_b_beta_std <-
    path_b_beta *
    sd_m /
    sd_y

  direct_beta_std <-
    direct_beta *
    sd_x /
    sd_y

  total_c_beta_std <-
    total_c_beta *
    sd_x /
    sd_y

  indirect_ab <-
    path_a_beta *
    path_b_beta

  indirect_ab_std <-
    path_a_beta_std *
    path_b_beta_std

  set.seed(
    current$Model_seed[[1]]
  )

  med_fit <- mediation::mediate(
    model.m = model_m,
    model.y = model_y,
    treat = exposure_var,
    mediator = mediator_var,
    boot = TRUE,
    sims = n_boot
  )

  ACME_std <-
    med_fit$d.avg *
    sd_x /
    sd_y

  ACME_std_CI_low <-
    med_fit$d.avg.ci[[1]] *
    sd_x /
    sd_y

  ACME_std_CI_high <-
    med_fit$d.avg.ci[[2]] *
    sd_x /
    sd_y

  tibble(
    Model_number = current$Model_number[[1]],
    Tier = current$Tier[[1]],
    Sample = sample_name,
    Exposure = exposure_label,
    Mediator_type = mediator_type,
    Family = current$Family[[1]],
    Mediator = mediator_label,
    Selection_FDR = current$Selection_FDR[[1]],
    Outcome = outcome_label,
    N = n_model,

    Path_a_beta = path_a_beta,
    Path_a_beta_std = path_a_beta_std,
    Path_a_p = path_a_p,

    Path_b_beta = path_b_beta,
    Path_b_beta_std = path_b_beta_std,
    Path_b_p = path_b_p,

    Total_effect_c = total_c_beta,
    Total_effect_c_std = total_c_beta_std,
    Total_effect_c_p = total_c_p,

    Direct_effect_cprime = direct_beta,
    Direct_effect_cprime_std = direct_beta_std,
    Direct_effect_cprime_p = direct_p,

    Indirect_ab = indirect_ab,
    Indirect_ab_std = indirect_ab_std,

    ACME = med_fit$d.avg,
    ACME_CI_low = med_fit$d.avg.ci[[1]],
    ACME_CI_high = med_fit$d.avg.ci[[2]],
    ACME_p = med_fit$d.avg.p,

    ACME_std = ACME_std,
    ACME_std_CI_low = ACME_std_CI_low,
    ACME_std_CI_high = ACME_std_CI_high,

    ADE = med_fit$z.avg,
    ADE_CI_low = med_fit$z.avg.ci[[1]],
    ADE_CI_high = med_fit$z.avg.ci[[2]],
    ADE_p = med_fit$z.avg.p,

    Total_effect = med_fit$tau.coef,
    Total_effect_CI_low = med_fit$tau.ci[[1]],
    Total_effect_CI_high = med_fit$tau.ci[[2]],
    Total_effect_p = med_fit$tau.p,

    Prop_mediated = med_fit$n.avg,
    Prop_mediated_CI_low = med_fit$n.avg.ci[[1]],
    Prop_mediated_CI_high = med_fit$n.avg.ci[[2]],
    Prop_mediated_p = med_fit$n.avg.p,

    Status = "OK"
  )
}


# Run mediation models ----------------------------------------------------

mediation_results <- map_dfr(
  seq_len(
    nrow(mediation_grid)
  ),
  function(i) {

    run_mediation_model(
      mediation_grid[
        i,
        ,
        drop = FALSE
      ]
    )
  }
)


# Multiple-testing correction --------------------------------------------

epigenetic_mediation <- mediation_results %>%
  filter(
    Mediator_type == "Epigenetic"
  ) %>%
  group_by(
    Tier,
    Sample,
    Exposure,
    Outcome,
    Family
  ) %>%
  mutate(
    ACME_FDR = p.adjust(
      ACME_p,
      method = "BH"
    )
  ) %>%
  ungroup()

brain_mediation <- mediation_results %>%
  filter(
    Mediator_type == "Brain aging"
  ) %>%
  group_by(
    Tier,
    Sample,
    Exposure,
    Outcome,
    Family
  ) %>%
  mutate(
    ACME_FDR = p.adjust(
      ACME_p,
      method = "BH"
    )
  ) %>%
  ungroup()

mediation_results <- bind_rows(
  epigenetic_mediation,
  brain_mediation
) %>%
  mutate(
    ACME_FDR_all_targeted = p.adjust(
      ACME_p,
      method = "BH"
    ),
    ACME_significant =
      !is.na(ACME_FDR) &
      ACME_FDR < 0.05
  ) %>%
  arrange(
    match(
      Sample,
      sample_order
    ),
    Tier,
    Exposure,
    Outcome,
    Mediator_type,
    Family,
    ACME_FDR
  )
