  Sample = loco_samples$Sample,
  Exposure = names(
    global_social_vars
  ),
  Outcome = names(
    eaa_vars
  )
) %>%
  left_join(
    loco_samples,
    by = "Sample"
  ) %>%
  mutate(
    Family = get_eaa_family(
      Outcome
    )
  ) %>%
  pmap_dfr(

    function(
      Sample,
      Exposure,
      Outcome,
      Country_excluded,
      Family
    ) {

      model_data <- if (
        is.na(
          Country_excluded
        )
      ) {

        data_base

      } else {

        data_base %>%
          filter(
            country !=
            Country_excluded
          ) %>%
          droplevels()
      }


      fit_association(
        data = model_data,
        exposure =
          global_social_vars[[Exposure]],
        outcome =
          eaa_vars[[Outcome]],
        covariates = c(
          "age",
          "sex",
          "smoking",
          "country",
          "diagnosis_binary"
        )
      ) %>%
        mutate(
          Sample = Sample,
          Country_excluded =
            Country_excluded,
          Exposure = Exposure,
          Outcome = Outcome,
          Family = Family,
          Outcome_family = "EAA"
        )
    }
  ) %>%
  group_by(
    Sample,
    Exposure,
    Family
  ) %>%
  mutate(
    FDR = p.adjust(
      p_value,
      method = "BH"
    )
  ) %>%
  ungroup()


