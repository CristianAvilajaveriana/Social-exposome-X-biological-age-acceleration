get_eaa_family <- function(outcome) {

  case_when(
    outcome %in% non_organ ~ "Non-organ",
    outcome %in% organ_system ~ "Organ / Systems"
  )
}


# ==============================================================================
# 1. Incremental contribution of social exposome measures
# ==============================================================================

fit_incremental <- function(
  data,
  exposure,
  outcome,
  covariates,
  min_n = 20
) {

  model_data <- data %>%
    select(
      all_of(
        c(
          outcome,
          exposure,
          covariates
        )
      )
    ) %>%
    drop_na() %>%
    as.data.frame()


  if (nrow(model_data) < min_n) {
    return(NULL)
  }


  if (
    sd(model_data[[exposure]]) == 0 ||
    sd(model_data[[outcome]]) == 0
  ) {
    return(NULL)
  }


  reduced_fit <- lm(
    reformulate(
      covariates,
      response = outcome
    ),
    data = model_data
  )


  full_fit <- lm(
    reformulate(
      c(
        exposure,
        covariates
      ),
      response = outcome
    ),
    data = model_data
  )


  exposure_term <- broom::tidy(
    full_fit,
    conf.int = TRUE
  ) %>%
    filter(
      term == exposure
    )


  model_comparison <- anova(
    reduced_fit,
    full_fit
  )


  r2_reduced <- summary(
    reduced_fit
  )$r.squared


  r2_full <- summary(
    full_fit
  )$r.squared


  delta_r2 <- r2_full - r2_reduced


  scale_factor <-
    sd(model_data[[exposure]]) /
    sd(model_data[[outcome]])


  tibble(
    N = nobs(full_fit),
    Beta = exposure_term$estimate,
    SE = exposure_term$std.error,
    Beta_std = exposure_term$estimate * scale_factor,
    CI_low_std = exposure_term$conf.low * scale_factor,
    CI_high_std = exposure_term$conf.high * scale_factor,
    p_beta = exposure_term$p.value,
    R2_covariates = r2_reduced,
    R2_full = r2_full,
    Adjusted_R2 = summary(full_fit)$adj.r.squared,
    Delta_R2 = delta_r2,
    f2 = delta_r2 / (1 - r2_full),
    p_model_comparison = model_comparison$`Pr(>F)`[2]
  )
}


incremental_eaa_grid <- crossing(
  Exposure = names(social_vars),
  Outcome = names(eaa_vars_incremental)
) %>%
  mutate(
    Family = case_when(
      Outcome %in% non_organ_incremental ~ "Non-organ",
      Outcome %in% organ_system ~ "Organ / Systems"
    )
  )


incremental_bag_grid <- crossing(
  Exposure = names(social_vars),
  Outcome = names(bag_vars)
) %>%
  mutate(
    Family = "BAG"
  )


incremental_eaa_results <- pmap_dfr(

  incremental_eaa_grid,

  function(
    Exposure,
    Outcome,
    Family
  ) {

    fit_incremental(
      data = data_base,
      exposure = social_vars[[Exposure]],
      outcome = eaa_vars_incremental[[Outcome]],
      covariates = c(
        "age",
        "sex",
        "smoking",
        "country",
        "diagnosis_binary"
      )
    ) %>%
      mutate(
        Exposure = Exposure,
        Outcome = Outcome,
        Family = Family,
        Outcome_family = "EAA"
      )
  }
)


incremental_bag_results <- pmap_dfr(

  incremental_bag_grid,

  function(
    Exposure,
    Outcome,
    Family
  ) {

    fit_incremental(
      data = data_base,
      exposure = social_vars[[Exposure]],
      outcome = bag_vars[[Outcome]],
      covariates = c(
        "age",
        "sex",
        "smoking"
      )
    ) %>%
      mutate(
        Exposure = Exposure,
        Outcome = Outcome,
        Family = Family,
        Outcome_family = "BAG"
      )
  }
)


incremental_results <- bind_rows(
  incremental_eaa_results,
  incremental_bag_results
) %>%
  group_by(
    Exposure,
    Family
  ) %>%
  mutate(
    FDR = p.adjust(
      p_model_comparison,
      method = "BH"
    ),
    Significant_FDR = FDR < 0.05
  ) %>%
  ungroup()


# ==============================================================================
# 2. Effect-modification analyses
# ==============================================================================

run_interaction_model <- function(
  data,
  outcome,
  exposure,
  moderator,
  covariates,
  block,
  exposure_label,
  outcome_label,
  family_label,
  moderator_label,
  continuous_moderator = FALSE,
  min_n = 30
) {

  model_vars <- unique(
    c(
      outcome,
      exposure,
      moderator,
      covariates
    )
  )


  model_data <- data %>%
    select(
      all_of(
        model_vars
      )
    ) %>%
    drop_na() %>%
    as.data.frame() %>%
    droplevels()


  if (nrow(model_data) < min_n) {
    return(NULL)
  }


  if (
    sd(model_data[[outcome]]) == 0 ||
    sd(model_data[[exposure]]) == 0
  ) {
    return(NULL)
  }


  model_data$y_z <- as.numeric(
    scale(
      model_data[[outcome]]
    )
  )


  model_data$x_z <- as.numeric(
    scale(
      model_data[[exposure]]
    )
  )


  covariates_use <- setdiff(
    covariates,
    c(
      exposure,
      moderator
    )
  )


  covariate_text <- if (
    length(covariates_use) > 0
  ) {

    paste0(
      " + ",
      paste(
        covariates_use,
        collapse = " + "
      )
    )

  } else {

    ""
  }


  if (continuous_moderator) {

    if (
      sd(
        model_data[[moderator]]
      ) == 0
    ) {
      return(NULL)
    }


    model_data$mod_z <- as.numeric(
      scale(
        model_data[[moderator]]
      )
    )


    full_fit <- lm(
      as.formula(
        paste0(
          "y_z ~ x_z * mod_z",
          covariate_text
        )
      ),
      data = model_data
    )


    reduced_fit <- lm(
      as.formula(
        paste0(
          "y_z ~ x_z + mod_z",
          covariate_text
        )
      ),
      data = model_data
    )


    global_test <- anova(
      reduced_fit,
      full_fit
    )


    global_result <- tibble(
      Block = block,
      Exposure = exposure_label,
      Moderator = moderator_label,
      Outcome = outcome_label,
      Family = family_label,
      N = nobs(full_fit),
      F = global_test$F[2],
      df = global_test$Df[2],
      p_value = global_test$`Pr(>F)`[2],
      Adjusted_R2 = summary(full_fit)$adj.r.squared
    )


    coefficient_result <- broom::tidy(
      full_fit,
      conf.int = TRUE
    ) %>%
      filter(
        term == "x_z:mod_z"
      ) %>%
      transmute(
        Block = block,
        Exposure = exposure_label,
        Moderator = moderator_label,
        Outcome = outcome_label,
        Family = family_label,
        Contrast = paste0(
          exposure_label,
          " x ",
          moderator_label
        ),
        Beta_interaction = estimate,
        CI_low = conf.low,
        CI_high = conf.high,
        p_value = p.value,
        N = nobs(full_fit)
      )


    coefficients <- coef(
      full_fit
    )


    covariance_matrix <- vcov(
      full_fit
    )


    residual_df <- df.residual(
      full_fit
    )


    simple_slopes <- map_dfr(

      c(
        -1,
        0,
        1
      ),

      function(
        moderator_value
      ) {

        beta_slope <-
          coefficients["x_z"] +
          coefficients["x_z:mod_z"] *
          moderator_value


        slope_se <- sqrt(

          covariance_matrix[
            "x_z",
            "x_z"
          ] +

          moderator_value^2 *
          covariance_matrix[
            "x_z:mod_z",
            "x_z:mod_z"
          ] +

          2 *
          moderator_value *
          covariance_matrix[
            "x_z",
            "x_z:mod_z"
          ]
        )


        slope_label <- case_when(
          moderator_value == -1 ~ "Low (-1 SD)",
          moderator_value == 0 ~ "Mean",
          moderator_value == 1 ~ "High (+1 SD)"
        )


        tibble(
          Block = block,
          Exposure = exposure_label,
          Moderator = moderator_label,
          Outcome = outcome_label,
          Family = family_label,
          Simple_slope_level = slope_label,
          Beta_slope = beta_slope,
          CI_low =
            beta_slope -
            qt(
              0.975,
              residual_df
            ) *
            slope_se,
          CI_high =
            beta_slope +
            qt(
              0.975,
              residual_df
            ) *
            slope_se,
          p_value =
            2 *
            pt(
              abs(
                beta_slope /
                slope_se
              ),
              df = residual_df,
              lower.tail = FALSE
            ),
          N = nobs(full_fit)
        )
      }
    )

  } else {


    model_data$mod_fac <- droplevels(
      as.factor(
        model_data[[moderator]]
      )
    )


    if (
      nlevels(
        model_data$mod_fac
      ) < 2
    ) {
      return(NULL)
    }


    full_fit <- lm(
      as.formula(
        paste0(
          "y_z ~ x_z * mod_fac",
          covariate_text
        )
      ),
      data = model_data
    )


    reduced_fit <- lm(
      as.formula(
        paste0(
          "y_z ~ x_z + mod_fac",
          covariate_text
        )
      ),
      data = model_data
    )


    global_test <- anova(
      reduced_fit,
      full_fit
    )


    global_result <- tibble(
      Block = block,
      Exposure = exposure_label,
      Moderator = moderator_label,
      Outcome = outcome_label,
      Family = family_label,
      N = nobs(full_fit),
      F = global_test$F[2],
      df = global_test$Df[2],
      p_value = global_test$`Pr(>F)`[2],
      Adjusted_R2 = summary(full_fit)$adj.r.squared
    )


    reference_level <- levels(
      model_data$mod_fac
    )[1]


    coefficient_result <- broom::tidy(
      full_fit,
      conf.int = TRUE
    ) %>%
      filter(
        grepl(
          ":",
          term
        ),
        grepl(
          "x_z",
          term
        ),
        grepl(
          "mod_fac",
          term
        )
      ) %>%
      mutate(
        level = gsub(
          "x_z:mod_fac|mod_fac|:x_z",
          "",
          term
        )
      ) %>%
      transmute(
        Block = block,
        Exposure = exposure_label,
        Moderator = moderator_label,
        Outcome = outcome_label,
        Family = family_label,
        Contrast = paste0(
          exposure_label,
          " x ",
          level,
          " vs ",
          reference_level
        ),
        Beta_interaction = estimate,
        CI_low = conf.low,
        CI_high = conf.high,
        p_value = p.value,
        N = nobs(full_fit)
      )


    coefficients <- coef(
      full_fit
    )


    covariance_matrix <- vcov(
      full_fit
    )


    residual_df <- df.residual(
      full_fit
    )


    simple_slopes <- map_dfr(

      levels(
        model_data$mod_fac
      ),

      function(
        level_i
      ) {

        if (
          level_i ==
          reference_level
        ) {

          beta_slope <-
            coefficients["x_z"]


          slope_variance <-
            covariance_matrix[
              "x_z",
              "x_z"
            ]

        } else {

          interaction_term <- paste0(
            "x_z:mod_fac",
            level_i
          )


          if (
            !interaction_term %in%
            names(coefficients)
          ) {

            interaction_term <- paste0(
              "mod_fac",
              level_i,
              ":x_z"
            )
          }


          beta_slope <-
            coefficients["x_z"] +
            coefficients[[interaction_term]]


          slope_variance <-
            covariance_matrix[
              "x_z",
              "x_z"
            ] +
            covariance_matrix[
              interaction_term,
              interaction_term
            ] +
            2 *
            covariance_matrix[
              "x_z",
              interaction_term
            ]
        }


        slope_se <- sqrt(
          slope_variance
        )


        tibble(
          Block = block,
          Exposure = exposure_label,
          Moderator = moderator_label,
          Outcome = outcome_label,
          Family = family_label,
          Simple_slope_level = level_i,
          Beta_slope = beta_slope,
          CI_low =
            beta_slope -
            qt(
              0.975,
              residual_df
            ) *
            slope_se,
          CI_high =
            beta_slope +
            qt(
              0.975,
              residual_df
            ) *
            slope_se,
          p_value =
            2 *
            pt(
              abs(
                beta_slope /
                slope_se
              ),
              df = residual_df,
              lower.tail = FALSE
            ),
          N = nobs(full_fit)
        )
      }
    )
  }


  list(
    global = global_result,
    coefficients = coefficient_result,
    simple_slopes = simple_slopes
  )
}


run_interaction_grid <- function(
  data,
  exposures,
  moderator,
  covariates,
  block,
  moderator_label,
  continuous_moderator = FALSE
) {

  crossing(
    Exposure = names(exposures),
    Outcome = names(eaa_vars)
  ) %>%
    mutate(
      Family = get_eaa_family(
        Outcome
      )
    ) %>%
    pmap(

      function(
        Exposure,
        Outcome,
        Family
      ) {

        run_interaction_model(
          data = data,
          outcome = eaa_vars[[Outcome]],
          exposure = exposures[[Exposure]],
          moderator = moderator,
          covariates = covariates,
          block = block,
          exposure_label = Exposure,
          outcome_label = Outcome,
          family_label = Family,
          moderator_label = moderator_label,
          continuous_moderator = continuous_moderator
        )
      }
    ) %>%
    compact()
}


min_country_n <- 30


countries_for_interaction <- data_base %>%
  count(
    country
  ) %>%
  filter(
    n >= min_country_n
  ) %>%
  pull(
    country
  )


interaction_models <- c(


  run_interaction_grid(
    data = data_base,
    exposures = social_vars,
    moderator = "diagnosis_binary",
    covariates = c(
      "sex",
      "smoking",
      "country",
      "age"
    ),
    block = "Social exposure x cognitive status",
    moderator_label = "Cognitive status"
  ),


  run_interaction_grid(
    data = data_base %>%
      filter(
        !is.na(
          clinical_diagnosis
        )
      ) %>%
      droplevels(),
    exposures = social_vars,
    moderator = "clinical_diagnosis",
    covariates = c(
      "sex",
      "smoking",
      "country",
      "age"
    ),
    block = "Social exposure x clinical diagnosis",
    moderator_label = "Clinical diagnosis"
  ),


  run_interaction_grid(
    data = data_base,
    exposures = social_vars,
    moderator = "sex",
    covariates = c(
      "smoking",
      "country",
      "age",
      "diagnosis_binary"
    ),
    block = "Social exposure x sex",
    moderator_label = "Sex"
  ),


  run_interaction_grid(
    data = data_base %>%
      filter(
        country %in%
        countries_for_interaction
      ) %>%
      droplevels(),
    exposures = social_vars,
    moderator = "country",
    covariates = c(
      "sex",
      "smoking",
      "age",
      "diagnosis_binary"
    ),
    block = "Social exposure x country",
    moderator_label = "Country"
  ),


  run_interaction_grid(
    data = data_base,
    exposures = social_vars,
    moderator = "age",
    covariates = c(
      "sex",
      "smoking",
      "country",
      "diagnosis_binary"
    ),
    block = "Social exposure x chronological age",
    moderator_label = "Age",
    continuous_moderator = TRUE
  ),


  run_interaction_grid(
    data = data_base,
    exposures = c(
      CSRI = "CSRI"
    ),
    moderator = "MSE",
    covariates = c(
      "sex",
      "smoking",
      "country",
      "age",
      "diagnosis_binary"
    ),
    block = "CSRI x MSE",
    moderator_label = "MSE",
    continuous_moderator = TRUE
  )
)


interaction_global <- map_dfr(
  interaction_models,
  "global"
) %>%
  group_by(
    Block,
    Exposure,
    Family
  ) %>%
  mutate(
    Interaction_FDR = p.adjust(
      p_value,
      method = "BH"
    ),
    Significant_FDR =
      Interaction_FDR <
      0.05
  ) %>%
  ungroup()


interaction_coefficients <- map_dfr(
  interaction_models,
  "coefficients"
) %>%
  group_by(
    Block,
    Exposure,
    Moderator,
    Family
  ) %>%
  mutate(
    Coefficient_FDR = p.adjust(
      p_value,
      method = "BH"
    )
  ) %>%
  ungroup()


interaction_simple_slopes <- map_dfr(
  interaction_models,
  "simple_slopes"
) %>%
  group_by(
    Block,
    Exposure,
    Moderator,
    Simple_slope_level,
    Family
  ) %>%
  mutate(
    Simple_slope_FDR = p.adjust(
      p_value,
      method = "BH"
    )
  ) %>%
  ungroup()


# ==============================================================================
# 3. Sex-stratified analyses
# ==============================================================================

fit_association <- function(
  data,
  exposure,
  outcome,
  covariates,
  min_n = 20
) {

  model_data <- data %>%
    select(
      all_of(
        c(
          outcome,
          exposure,
          covariates
        )
      )
    ) %>%
    drop_na() %>%
    as.data.frame() %>%
    droplevels()


  if (
    nrow(
      model_data
    ) < min_n
  ) {
    return(NULL)
  }


  if (
    sd(
      model_data[[exposure]]
    ) == 0 ||
    sd(
      model_data[[outcome]]
    ) == 0
  ) {
    return(NULL)
  }


  full_fit <- lm(
    reformulate(
      c(
        exposure,
        covariates
      ),
      response = outcome
    ),
    data = model_data
  )


  reduced_fit <- lm(
    reformulate(
      covariates,
      response = outcome
    ),
    data = model_data
  )


  exposure_term <- broom::tidy(
    full_fit,
    conf.int = TRUE
  ) %>%
    filter(
      term == exposure
    )


  scale_factor <-
    sd(
      model_data[[exposure]]
    ) /
    sd(
      model_data[[outcome]]
    )


  r2_full <- summary(
    full_fit
  )$r.squared


  r2_reduced <- summary(
    reduced_fit
  )$r.squared


  delta_r2 <-
    r2_full -
    r2_reduced


  tibble(
    N = nobs(full_fit),
    Beta = exposure_term$estimate,
    SE = exposure_term$std.error,
    Beta_std =
      exposure_term$estimate *
      scale_factor,
    CI_low_std =
      exposure_term$conf.low *
      scale_factor,
    CI_high_std =
      exposure_term$conf.high *
      scale_factor,
    p_value =
      exposure_term$p.value,
    R2_full =
      r2_full,
    R2_reduced =
      r2_reduced,
    Adjusted_R2 =
      summary(
        full_fit
      )$adj.r.squared,
    Delta_R2 =
      delta_r2,
    f2 =
      delta_r2 /
      (1 - r2_full)
  )
}


