# ==============================================================================
# 5. Country-level meta-analysis
# ==============================================================================

fit_country_model <- function(
  data,
  exposure,
  outcome,
  covariates,
  min_n = 20
) {

  model_data <- data %>%
    select(
      all_of(
        c(
          outcome,
          exposure,
          covariates
        )
      )
    ) %>%
    drop_na() %>%
    as.data.frame() %>%
    droplevels()


  if (
    nrow(
      model_data
    ) < min_n
  ) {
    return(NULL)
  }


  if (
    sd(
      model_data[[exposure]]
    ) == 0 ||
    sd(
      model_data[[outcome]]
    ) == 0
  ) {
    return(NULL)
  }


  model_data$x_std <- as.numeric(
    scale(
      model_data[[exposure]]
    )
  )


  model_data$y_std <- as.numeric(
    scale(
      model_data[[outcome]]
    )
  )


  full_fit <- lm(
    reformulate(
      c(
        "x_std",
        covariates
      ),
      response = "y_std"
    ),
    data = model_data
  )


  reduced_fit <- lm(
    reformulate(
      covariates,
      response = "y_std"
    ),
    data = model_data
  )


  exposure_term <- broom::tidy(
    full_fit,
    conf.int = TRUE
  ) %>%
    filter(
      term == "x_std"
    )


  r2_full <- summary(
    full_fit
  )$r.squared


  r2_reduced <- summary(
    reduced_fit
  )$r.squared


  delta_r2 <-
    r2_full -
    r2_reduced


  tibble(
    N = nobs(full_fit),
    Beta_std =
      exposure_term$estimate,
    SE_std =
      exposure_term$std.error,
    CI_low_std =
      exposure_term$conf.low,
    CI_high_std =
      exposure_term$conf.high,
    p_value =
      exposure_term$p.value,
    Adjusted_R2 =
      summary(
        full_fit
      )$adj.r.squared,
    f2 =
      delta_r2 /
      (1 - r2_full)
  )
}


country_eaa_results <- crossing(
  Country = country_order,
  Exposure = names(
    global_social_vars
  ),
  Outcome = names(
    eaa_vars
  )
) %>%
  mutate(
    Family = get_eaa_family(
      Outcome
    )
  ) %>%
  pmap_dfr(

    function(
      Country,
      Exposure,
      Outcome,
      Family
    ) {

      fit_country_model(
        data =
          data_base %>%
          filter(
            country ==
            Country
          ),
        exposure =
          global_social_vars[[Exposure]],
        outcome =
          eaa_vars[[Outcome]],
        covariates = c(
          "age",
          "sex",
          "smoking",
          "diagnosis_binary"
        )
      ) %>%
        mutate(
          Country = Country,
          Exposure = Exposure,
          Outcome = Outcome,
          Outcome_family = "EAA",
          Family = Family
        )
    }
  )


country_bag_results <- crossing(
  Country = country_order,
  Exposure = names(
    global_social_vars
  ),
  Outcome = names(
    functional_bag
  )
) %>%
  pmap_dfr(

    function(
      Country,
      Exposure,
      Outcome
    ) {

      fit_country_model(
        data =
          data_base %>%
          filter(
            country ==
            Country
          ),
        exposure =
          global_social_vars[[Exposure]],
        outcome =
          functional_bag[[Outcome]],
        covariates = c(
          "age",
          "sex",
          "smoking"
        )
      ) %>%
