          Outcome_family = "BAG",
          Family = Outcome
        )
    }
  )


country_results <- bind_rows(
  country_eaa_results,
  country_bag_results
)


meta_results <- country_results %>%
  group_by(
    Exposure,
    Outcome,
    Outcome_family,
    Family
  ) %>%
  group_modify(

    ~ {

      model_data <- .x %>%
        filter(
          !is.na(
            Beta_std
          ),
          !is.na(
            SE_std
          ),
          SE_std > 0
        )


      if (
        nrow(
          model_data
        ) < 2
      ) {
        return(
          tibble()
        )
      }


      random_fit <- metafor::rma.uni(
        yi = model_data$Beta_std,
        sei = model_data$SE_std,
        method = "REML",
        test = "knha"
      )


      common_fit <- metafor::rma.uni(
        yi = model_data$Beta_std,
        sei = model_data$SE_std,
        method = "FE"
      )


      tibble(
        k = nrow(model_data),
        Beta_random =
          as.numeric(
            random_fit$b
          ),
        SE_random =
          random_fit$se,
        CI_low_random =
          random_fit$ci.lb,
        CI_high_random =
          random_fit$ci.ub,
        p_random =
          random_fit$pval,
        tau2 =
          random_fit$tau2,
        I2 =
          random_fit$I2,
        Q =
          random_fit$QE,
        Q_p =
          random_fit$QEp,
        Beta_common =
          as.numeric(
            common_fit$b
          ),
        SE_common =
          common_fit$se,
        CI_low_common =
          common_fit$ci.lb,
        CI_high_common =
          common_fit$ci.ub,
        p_common =
          common_fit$pval
      )
    }
  ) %>%
  ungroup() %>%
  group_by(
    Exposure,
    Outcome_family,
    Family
  ) %>%
  mutate(
    FDR_random = p.adjust(
      p_random,
      method = "BH"
    ),
    FDR_common = p.adjust(
      p_common,
      method = "BH"
    )
  ) %>%
  ungroup()


# ==============================================================================
# 6. Repeated 60:40 training-validation subsampling
# ==============================================================================

N_SPLITS <- 100L

TRAIN_PROP <- 0.60

BASE_SEED <- 20260912L


make_stratified_split <- function(
  data,
  seed,
  train_prop = TRAIN_PROP
) {

  set.seed(
    seed
  )


  split_data <- data %>%
    mutate(
      .row_id = row_number(),
      .stratum = interaction(
        country,
        diagnosis_binary,
        drop = TRUE,
        lex.order = TRUE
      )
    )


  split_ids <- split_data %>%
    group_by(
      .stratum
    ) %>%
    group_modify(

      ~ {

        ids <- .x$.row_id

        n <- length(
          ids
        )


        if (
          n == 1L
        ) {

          n_train <- rbinom(
            1,
            1,
            train_prop
          )

        } else {

          n_train <- round(
            train_prop *
            n
          )


          n_train <- max(
            1L,
            min(
              n - 1L,
              n_train
            )
          )
        }


        train_ids <- if (
          n_train > 0
        ) {

          sample(
            ids,
            n_train
          )

        } else {

          integer(
            0
          )
        }


        tibble(
          .row_id = ids,
          Set = ifelse(
            ids %in%
            train_ids,
            "Training",
            "Validation"
          )
        )
      }
    ) %>%
    ungroup() %>%
    select(
      .row_id,
      Set
    )


  split_data %>%
    select(
      -.stratum
    ) %>%
    left_join(
      split_ids,
      by = ".row_id"
    )
}


fit_subsampling_model <- function(
  data,
  exposure,
  outcome,
  outcome_family,
  min_n = 20
) {

  covariates <- if (
    outcome_family ==
    "EAA"
  ) {

    c(
      "age",
      "sex",
      "smoking",
      "country",
      "diagnosis_binary"
    )

  } else {

    c(
      "age",
      "sex",
      "smoking"
    )
  }


  model_data <- data %>%
    select(
      all_of(
        c(
          outcome,
          exposure,
          covariates
        )
      )
    ) %>%
    drop_na() %>%
    as.data.frame() %>%
    droplevels()


  if (
    nrow(
      model_data
    ) < min_n
  ) {
    return(NULL)
  }


  if (
    sd(
      model_data[[exposure]]
    ) == 0 ||
    sd(
      model_data[[outcome]]
    ) == 0
  ) {
    return(NULL)
  }


  model_data$x_std <- as.numeric(
    scale(
      model_data[[exposure]]
    )
  )


  model_data$y_std <- as.numeric(
    scale(
      model_data[[outcome]]
    )
  )


  fit <- lm(
    reformulate(
      c(
        "x_std",
        covariates
      ),
      response = "y_std"
    ),
    data = model_data
  )


  exposure_term <- broom::tidy(
    fit,
    conf.int = TRUE
  ) %>%
    filter(
      term == "x_std"
    )


  tibble(
    N = nobs(fit),
    Beta_std =
      exposure_term$estimate,
    SE =
      exposure_term$std.error,
    CI_low =
      exposure_term$conf.low,
    CI_high =
      exposure_term$conf.high,
    p_value =
      exposure_term$p.value,
    Adjusted_R2 =
      summary(
        fit
      )$adj.r.squared
  )
}


fit_subsampling_family <- function(
  data,
  exposure_label
) {

  exposure <- global_social_vars[
    [exposure_label]
  ]


  eaa_results <- imap_dfr(

    eaa_vars,

    function(
      outcome,
      outcome_label
    ) {

      fit_subsampling_model(
        data = data,
        exposure = exposure,
        outcome = outcome,
        outcome_family = "EAA"
      ) %>%
        mutate(
          Outcome =
            outcome_label,
          Outcome_family =
            "EAA",
          Family =
            get_eaa_family(
              outcome_label
            )
        )
    }
  )


  bag_results <- imap_dfr(

    bag_vars,

    function(
      outcome,
      outcome_label
    ) {

      fit_subsampling_model(
        data = data,
        exposure = exposure,
        outcome = outcome,
        outcome_family = "BAG"
      ) %>%
        mutate(
          Outcome =
            outcome_label,
          Outcome_family =
            "BAG",
          Family =
            outcome_label
        )
    }
  )


  bind_rows(
    eaa_results,
    bag_results
  ) %>%
    mutate(
      Exposure =
        exposure_label
    ) %>%
    group_by(
      Exposure,
      Family
    ) %>%
    mutate(
      FDR = p.adjust(
        p_value,
        method = "BH"
      )
    ) %>%
    ungroup()
}


subsampling_full_reference <- map_dfr(

  names(
    global_social_vars
  ),

  ~ fit_subsampling_family(
    data_base,
    .x
  )

) %>%
  mutate(
    Reference_direction =
      sign(
        Beta_std
      )
  )


subsampling_results <- map_dfr(

  seq_len(
    N_SPLITS
  ),

  function(
    i
  ) {

    split_data <- make_stratified_split(
      data = data_base,
      seed = BASE_SEED + i
    )


    map_dfr(

      c(
        "Training",
        "Validation"
      ),

      function(
        set_name
      ) {

        model_data <- split_data %>%
          filter(
            Set ==
            set_name
          )


        map_dfr(

          names(
            global_social_vars
          ),

          ~ fit_subsampling_family(
            model_data,
            .x
          )

        ) %>%
          mutate(
            Split = i,
            Set = set_name,
            Seed =
              BASE_SEED +
              i
          )
      }
    )
  }
)


subsampling_primary_results <- subsampling_results %>%
  inner_join(
    primary_targets,
    by = c(
      "Exposure",
      "Outcome"
    )
  )


subsampling_summary <- subsampling_primary_results %>%
  left_join(

    subsampling_full_reference %>%
      select(
        Exposure,
        Outcome,
        Reference_direction,
        Full_Beta_std =
          Beta_std
      ),

    by = c(
      "Exposure",
      "Outcome"
    )
  ) %>%
  mutate(
    Same_direction =
      sign(
        Beta_std
      ) ==
      Reference_direction,
    Nominal_significant =
      p_value <
      0.05,
    FDR_significant =
      FDR <
      0.05
  ) %>%
  group_by(
    Exposure,
    Outcome,
    Set
  ) %>%
  summarise(
    Iterations_available =
      sum(
        !is.na(
          Beta_std
        )
      ),
    Median_beta =
      median(
        Beta_std,
        na.rm = TRUE
      ),
    Q1_beta =
      quantile(
        Beta_std,
        0.25,
        na.rm = TRUE
      ),
    Q3_beta =
      quantile(
        Beta_std,
        0.75,
        na.rm = TRUE
      ),
    Same_direction_prop =
      mean(
        Same_direction,
        na.rm = TRUE
      ),
    Nominal_significant_prop =
      mean(
        Nominal_significant,
        na.rm = TRUE
      ),
    FDR_significant_prop =
      mean(
        FDR_significant,
        na.rm = TRUE
      ),
    .groups = "drop"
  )
