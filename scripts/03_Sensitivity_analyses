# ==============================================================================
# Sensitivity analyses
# The social exposome and biological aging in dementia across Latin America
# ==============================================================================
#
# This script contains the sensitivity analyses used to assess the robustness
# and heterogeneity of the main associations between the social exposome and
# biological aging.
#
# Analyses include:
#   1. Incremental contribution of social exposome measures
#   2. Effect-modification analyses
#   3. Sex-stratified analyses
#   4. Leave-one-country-out analysis
#   5. Country-level meta-analysis
#   6. Repeated 60:40 training-validation subsampling
#
# Multiple testing is controlled using the Benjamini-Hochberg false discovery
# rate (FDR) within the prespecified analysis families.
#
# The script assumes an analysis-ready harmonized dataset (`data_base`).
#
# ==============================================================================


library(dplyr)
library(tidyr)
library(purrr)
library(tibble)
library(broom)
library(metafor)


